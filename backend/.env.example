# Which settings module to use: config.settings.development or config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

DEBUG=True
SECRET_KEY=your-secret-key-here

# Only required by config.settings.production (development.py uses SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/letsinternz

# AWS S3 (media storage) — optional; falls back to local disk if unset.
# Also used for any S3-compatible provider (Supabase Storage, R2, etc) —
# see DEPLOY_SUPABASE.md for that setup and what these values become.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=letsinternz-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=

# Email sender — set these to send real OTP emails via Hostinger or another SMTP provider.
DEFAULT_FROM_EMAIL=help@letsinternz.com
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=help@letsinternz.com
EMAIL_HOST_PASSWORD=replace-with-hostinger-email-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=30

# AWS SES (email fallback for config.settings.production)
AWS_SES_REGION_NAME=ap-south-1
AWS_SES_REGION_ENDPOINT=

# Optional: only set this if you intentionally want Redis-backed cache/Celery.
REDIS_URL=
CACHE_BACKEND=locmem

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# Optional error tracking, production only
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
